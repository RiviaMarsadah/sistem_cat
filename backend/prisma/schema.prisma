// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  guru
  siswa
}

enum UserStatus {
  aktif
  nonaktif
}

enum KelasTingkat {
  X
  XI
  XII
  ALUMNI
  KI
}

/// Untuk bank_soal: X, XI, XII, atau SEMUA (soal dipakai semua tingkat).
/// Di DB nilai "SEMUA" disimpan; frontend bisa kirim "0" yang dipetakan ke SEMUA.
enum TingkatSoal {
  X
  XI
  XII
  SEMUA
}

enum TipeUjian {
  UH
  UTS
  UAS
  Lainnya
}

enum KategoriJadwal {
  terjadwal
  custom
}

enum JenisKelamin {
  L
  P
}

model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique @db.VarChar(100)
  password      String?    @db.VarChar(255)
  role          UserRole
  namaLengkap   String     @map("nama_lengkap") @db.VarChar(100)
  status        UserStatus @default(aktif)
  googleId      String?    @unique @map("google_id") @db.VarChar(255)
  googlePicture String?    @map("google_picture") @db.VarChar(500)
  googleLinked  Boolean    @default(false) @map("google_linked")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  // Relations
  guru  Guru?
  siswa Siswa?

  @@map("users")
}

model Guru {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  nip             String?       @db.VarChar(20)
  jk              JenisKelamin? @map("jk")
  foto            String?       @default("default.jpg") @db.VarChar(255)
  tempatLahir     String?       @map("tempat_lahir") @db.VarChar(100)
  tglLahir        String?       @map("tgl_lahir") @db.VarChar(20)
  agama           String?       @db.VarChar(50)
  noHp            String?       @map("nohp") @db.VarChar(20)
  provinsi        String?       @db.VarChar(100)
  kabupaten       String?       @db.VarChar(100)
  kecamatan       String?       @db.VarChar(100)
  desa            String?       @db.VarChar(100)
  alamat          String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankSoal        BankSoal[]
  bankSoalKoleksi BankSoalKoleksi[]
  paketUjian      PaketUjian[]
  jadwalUjians    JadwalUjian[]

  @@map("guru")
}

model BankSoalKoleksi {
  id        Int      @id @default(autoincrement())
  guruId    Int      @map("guru_id")
  nama      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  guru     Guru       @relation(fields: [guruId], references: [id], onDelete: Cascade)
  bankSoal BankSoal[]

  @@unique([guruId, nama])
  @@map("bank_soal_koleksi")
}

model Siswa {
  id           Int           @id @default(autoincrement())
  userId       Int           @unique @map("user_id")
  nis          String?       @unique @db.VarChar(20)
  nisn         String?       @unique @db.VarChar(20)
  kelasId      Int?          @map("kelas_id")
  idAngkatan   Int?          @map("id_angkatan")
  jk           JenisKelamin? @map("jk")
  foto         String?       @default("default.jpg") @db.VarChar(255)
  tempatLahir  String?       @map("tempat_lahir") @db.VarChar(100)
  tglLahir     String?       @map("tgl_lahir") @db.VarChar(20)
  agama        String?       @db.VarChar(50)
  noHp         String?       @map("nohp") @db.VarChar(20)
  provinsi     String?       @db.VarChar(100)
  kabupaten    String?       @db.VarChar(100)
  kecamatan    String?       @db.VarChar(100)
  desa         String?       @db.VarChar(100)
  alamat       String?       @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relations
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kelas      Kelas?       @relation(fields: [kelasId], references: [id])
  angkatan   Angkatan?    @relation(fields: [idAngkatan], references: [id])
  ujianSiswa UjianSiswa[]

  @@map("siswa")
}

enum KategoriSoal {
  pilgan
  pilgan_kompleks
  pilgan_kategori
}

enum StatusUjianSiswa {
  waiting
  berlangsung
  selesai
}

enum StatusJawabanSiswa {
  dijawab
  kosong
  ragu_ragu
}

enum KategoriMapel {
  prodi
  muatan_lokal
}

model MataPelajaran {
  id        Int           @id @default(autoincrement())
  namaMapel String        @map("nama_mapel") @db.VarChar(100)
  kodeMapel String?       @unique @map("kode_mapel") @db.VarChar(20)
  deskripsi String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at")

  bankSoal     BankSoal[]
  paketUjian   PaketUjian[]
  jadwalUjians JadwalUjian[]

  @@map("mata_pelajaran")
}

model Kelas {
  id        Int          @id @default(autoincrement())
  namaKelas String       @map("nama_kelas") @db.VarChar(50)
  tingkat   KelasTingkat
  jurusanId Int          @map("jurusan_id")
  inisial   String       @db.VarChar(10)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // Relations
  siswa        Siswa[]
  jurusan      Jurusan       @relation(fields: [jurusanId], references: [id])
  kelasJadwals KelasJadwal[]

  @@unique([tingkat, jurusanId, inisial])
  @@map("kelas")
}

model Jurusan {
  id        Int      @id @default(autoincrement())
  kodeProdi String   @unique @map("kode_prodi") @db.VarChar(20)
  namaProdi String   @map("nama_prodi") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  kelas         Kelas[]
  bankSoal      BankSoal[]
  jadwalUjians  JadwalUjian[]

  @@map("jurusan")
}

model BankSoal {
  id                Int          @id @default(autoincrement())
  bankSoalKoleksiId Int?         @map("bank_soal_koleksi_id")
  mataPelajaranId   Int          @map("mata_pelajaran_id")
  tingkat           TingkatSoal
  jurusanId         Int?         @map("jurusan_id")
  guruId            Int          @map("guru_id")
  kategoriSoal      KategoriSoal @map("kategori_soal")
  soal              String?      @db.Text
  kolomA            String?      @map("kolom_a") @db.VarChar(500)
  kolomB            String?      @map("kolom_b") @db.VarChar(500)
  kolomC            String?      @map("kolom_c") @db.VarChar(500)
  kolomD            String?      @map("kolom_d") @db.VarChar(500)
  kolomE            String?      @map("kolom_e") @db.VarChar(500)
  jawaban           String       @db.VarChar(100)
  gambar            String?      @db.VarChar(500)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  bankSoalKoleksi BankSoalKoleksi? @relation(fields: [bankSoalKoleksiId], references: [id], onDelete: SetNull)
  mataPelajaran   MataPelajaran    @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)
  jurusan         Jurusan?         @relation(fields: [jurusanId], references: [id], onDelete: SetNull)
  guru            Guru             @relation(fields: [guruId], references: [id], onDelete: Cascade)
  soalPaketUjian  SoalPaketUjian[]
  jawabanSiswa    JawabanSiswa[]

  @@map("bank_soal")
}

model PaketUjian {
  id              Int         @id @default(autoincrement())
  nama            String      @map("nama") @db.VarChar(200)
  mataPelajaranId Int         @map("mata_pelajaran_id")
  tingkat         TingkatSoal
  tipeUjian       TipeUjian   @map("tipe_ujian")
  guruId          Int         @map("guru_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  mataPelajaran MataPelajaran    @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)
  guru          Guru             @relation(fields: [guruId], references: [id], onDelete: Cascade)
  soalPaket     SoalPaketUjian[]
  jadwalUjian   JadwalUjian[]

  @@map("paket_ujian")
}

model SoalPaketUjian {
  id           Int      @id @default(autoincrement())
  paketUjianId Int      @map("paket_ujian_id")
  bankSoalId   Int      @map("bank_soal_id")
  createdAt    DateTime @default(now()) @map("created_at")

  paketUjian PaketUjian @relation(fields: [paketUjianId], references: [id], onDelete: Cascade)
  bankSoal   BankSoal   @relation(fields: [bankSoalId], references: [id], onDelete: Cascade)

  @@unique([paketUjianId, bankSoalId])
  @@map("soal_paket_ujian")
}

model JadwalUjian {
  id              Int      @id @default(autoincrement())
  nama            String   @db.VarChar(100)
  kategori        KategoriJadwal @default(terjadwal)
  mataPelajaranId Int      @map("mata_pelajaran_id")
  mulai           DateTime @map("mulai_pada")
  selesai         DateTime @map("selesai_pada")
  durasi          Int      @default(60)
  token           String?  @db.VarChar(6)
  tokenCheckOut   String?  @map("token_checkout") @db.VarChar(6)

  guruId       Int?    @map("guru_id")
  opsiKeamanan Boolean @default(false) @map("opsi_keamanan")

  paketUjianId Int?    @map("paket_ujian_id")
  periodeId    Int?    @map("periode_id")
  jurusanId    Int?    @map("jurusan_id")
  ruangan      String? @db.VarChar(50)

  mataPelajaran MataPelajaran @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)
  paketUjian    PaketUjian?   @relation(fields: [paketUjianId], references: [id], onDelete: SetNull)
  guru          Guru?         @relation(fields: [guruId], references: [id], onDelete: Cascade)
  periode       PeriodeUjian? @relation(fields: [periodeId], references: [id], onDelete: SetNull)
  jurusan       Jurusan?      @relation(fields: [jurusanId], references: [id], onDelete: SetNull)

  kelasJadwal KelasJadwal[]
  ujianSiswa  UjianSiswa[]

  @@map("jadwal_ujian")
}

model KelasJadwal {
  id            Int @id @default(autoincrement())
  jadwalUjianId Int @map("jadwal_ujian_id")
  kelasId       Int @map("kelas_id")

  jadwal JadwalUjian @relation(fields: [jadwalUjianId], references: [id], onDelete: Cascade)
  kelas  Kelas       @relation(fields: [kelasId], references: [id], onDelete: Cascade)

  @@unique([jadwalUjianId, kelasId])
  @@map("kelas_jadwal")
}

model UjianSiswa {
  id            Int              @id @default(autoincrement())
  siswaId       Int              @map("siswa_id")
  jadwalUjianId Int              @map("jadwal_ujian_id")
  status        StatusUjianSiswa @default(berlangsung)
  randomSeed    Int              @map("random_seed")
  totalSoal     Int              @default(0) @map("total_soal")
  benar         Int              @default(0)
  salah         Int              @default(0)
  kosong        Int              @default(0)
  raguRagu      Int              @default(0) @map("ragu_ragu")
  nilaiAkhir    Decimal          @default(0) @map("nilai_akhir") @db.Decimal(5, 2)
  mulaiPada     DateTime         @default(now()) @map("mulai_pada")
  selesaiPada   DateTime?        @map("selesai_pada")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  siswa        Siswa          @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  jadwalUjian  JadwalUjian    @relation(fields: [jadwalUjianId], references: [id], onDelete: Cascade)
  jawabanSiswa JawabanSiswa[]

  @@unique([siswaId, jadwalUjianId])
  @@map("ujian_siswa")
}

model JawabanSiswa {
  id            Int                @id @default(autoincrement())
  ujianSiswaId  Int                @map("ujian_siswa_id")
  bankSoalId    Int                @map("bank_soal_id")
  nomorSoal     Int                @map("nomor_soal")
  tipeSoal      KategoriSoal       @map("tipe_soal")
  jawabanSiswa  String?            @map("jawaban_siswa") @db.VarChar(255)
  statusJawaban StatusJawabanSiswa @default(kosong) @map("status_jawaban")
  isBenar       Boolean?           @map("is_benar")
  skorItem      Decimal            @default(0) @map("skor_item") @db.Decimal(5, 2)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  ujian    UjianSiswa @relation(fields: [ujianSiswaId], references: [id], onDelete: Cascade)
  bankSoal BankSoal   @relation(fields: [bankSoalId], references: [id], onDelete: Cascade)

  @@unique([ujianSiswaId, bankSoalId])
  @@index([ujianSiswaId, nomorSoal])
  @@map("jawaban_siswa")
}

model PeriodeUjian {
  id          Int      @id @default(autoincrement())
  nama        String   @db.VarChar(100)
  mulai       DateTime @map("mulai_periode")
  selesai     DateTime @map("selesai_periode")
  semester    String   @db.VarChar(10)
  tahunAjaran String   @map("tahun_ajaran") @db.VarChar(20)
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  jadwalUjians JadwalUjian[]

  @@map("periode_ujian")
}

model Angkatan {
  id            Int      @id @default(autoincrement())
  namaAngkatan  String   @map("nama_angkatan") @db.VarChar(100)
  tahunAngkatan Int      @unique @map("tahun_angkatan")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  siswa Siswa[]

  @@map("angkatan")
}
